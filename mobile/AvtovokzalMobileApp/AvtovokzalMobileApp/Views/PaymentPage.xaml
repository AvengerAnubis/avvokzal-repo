<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AvtovokzalMobileApp.ViewModels"
             x:Class="AvtovokzalMobileApp.Views.PaymentPage"
             x:DataType="vm:PaymentViewModel"
             Title="Оплата"
             BackgroundColor="{StaticResource Slate50}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                               Color="{StaticResource Primary}" />

            <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Error}"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullConverter}}"
                   BackgroundColor="{StaticResource ErrorLight}" Padding="12,8" />

            <!-- Booking Details -->
            <Border BackgroundColor="White" StrokeShape="RoundRectangle 12" Padding="16"
                Stroke="{StaticResource Slate200}" StrokeThickness="1">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Детали бронирования" FontSize="18" FontAttributes="Bold"
                           TextColor="{StaticResource Slate900}" />

                    <Label FontSize="14" TextColor="{StaticResource Slate600}">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Маршрут: " FontAttributes="Bold" />
                                <Span Text="{Binding Booking.Trip.Route.Name}" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <Label FontSize="14" TextColor="{StaticResource Slate600}">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Отправление: " FontAttributes="Bold" />
                                <Span Text="{Binding Booking.Trip.DepartureTime, StringFormat='{0:dd.MM.yyyy HH:mm}'}" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <Label FontSize="14" TextColor="{StaticResource Slate600}">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Мест: " FontAttributes="Bold" />
                                <Span Text="{Binding Booking.Seats}" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <BoxView HeightRequest="1" Color="{StaticResource Slate200}" Margin="0,4" />

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Сумма:" FontSize="18" FontAttributes="Bold"
                               TextColor="{StaticResource Slate900}" />
                        <Label Grid.Column="1" Text="{Binding Booking.TotalPrice, StringFormat='{0:N0} ₽'}"
                               FontSize="20" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Payment Method -->
            <Label Text="Способ оплаты" FontSize="16" FontAttributes="Bold"
                   TextColor="{StaticResource Slate900}" />

            <RadioButton Content="Банковская карта" IsChecked="{Binding SelectedMethod, Converter={StaticResource RadioConverter}, ConverterParameter=card}"
                         GroupName="payment" BackgroundColor="White" Padding="12,8" />

            <RadioButton Content="СБП" IsChecked="{Binding SelectedMethod, Converter={StaticResource RadioConverter}, ConverterParameter=sbp}"
                         GroupName="payment" BackgroundColor="White" Padding="12,8" />

            <RadioButton Content="Наличные" IsChecked="{Binding SelectedMethod, Converter={StaticResource RadioConverter}, ConverterParameter=cash}"
                         GroupName="payment" BackgroundColor="White" Padding="12,8" />

            <!-- Payment Complete State -->
            <VerticalStackLayout Spacing="12" IsVisible="{Binding IsPaymentComplete}"
                                 HorizontalOptions="Center" Padding="20">
                <Label Text="✅" FontSize="48" HorizontalOptions="Center" />
                <Label Text="Оплата прошла успешно!" FontSize="20" FontAttributes="Bold"
                       TextColor="{StaticResource Success}" HorizontalOptions="Center" />
                <Label Text="{Binding Payment.TransactionId, StringFormat='ID транзакции: {0}'}"
                       FontSize="13" TextColor="{StaticResource Slate500}" HorizontalOptions="Center" />

                <Button Text="Посмотреть билет" Command="{Binding GoToTicketCommand}"
                        BackgroundColor="{StaticResource Primary}" TextColor="White"
                        FontAttributes="Bold" HeightRequest="48" Margin="0,12,0,0" />
                <Button Text="В личный кабинет" Command="{Binding GoToProfileCommand}"
                        BackgroundColor="Transparent" TextColor="{StaticResource Primary}"
                        BorderColor="{StaticResource Primary}" BorderWidth="1" />
            </VerticalStackLayout>

            <Button Text="Оплатить" Command="{Binding ProcessPaymentCommand}"
                    BackgroundColor="{StaticResource Success}" TextColor="White"
                    FontAttributes="Bold" HeightRequest="48"
                    IsVisible="{Binding IsPaymentComplete, Converter={StaticResource InverseBoolConverter}}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>