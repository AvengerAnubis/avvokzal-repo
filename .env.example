# =============================================================================
# Пример конфигурации для Docker Compose
# Скопируйте в .env и заполните свои значения:
#   cp .env.example .env
# =============================================================================

# --- PostgreSQL ---
POSTGRES_PASSWORD=12341234

# --- Backend (NestJS) ---
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Разрешённые CORS-домены (через запятую)
# Для Vercel укажите домен вашего frontend-проекта:
#   CORS_ORIGINS=https://avtovokzal.vercel.app,https://your-custom-domain.ru
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Admin seed (на первый запуск)
ADMIN_EMAIL=admin@avtovokzal.ru
ADMIN_PASSWORD=123123

# --- Frontend (Next.js) ---
# URL для API-запросов с клиента (браузера)
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# --- Порты (опционально) ---
POSTGRES_PORT=5432
BACKEND_PORT=3001
FRONTEND_PORT=3000
